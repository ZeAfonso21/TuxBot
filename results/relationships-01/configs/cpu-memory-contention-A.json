{
  "mode": "default",
  "defaults_verified": true,
  "results_dir": "results/relationships-01/cpu-memory-contention/A",
  "warmup_seconds": 10,
  "window_seconds": 8,
  "tuning_windows": 30,
  "stable_windows": 20,
  "require_perf_metrics": true,
  "regression_tolerance": 0.05,
  "regression_windows": 3,
  "approved_host_parameters": [
    "min_granularity_ns",
    "latency_ns",
    "wakeup_granularity_ns",
    "migration_cost_ns",
    "min_perf_pct",
    "max_perf_pct"
  ],
  "expected_initial_host": {
    "min_granularity_ns": 3000000,
    "latency_ns": 24000000,
    "wakeup_granularity_ns": 4000000,
    "migration_cost_ns": 500000,
    "min_perf_pct": 45,
    "max_perf_pct": 100
  },
  "host_limits": {
    "min_granularity_ns": [
      500000,
      6000000
    ],
    "latency_ns": [
      6000000,
      48000000
    ],
    "wakeup_granularity_ns": [
      0,
      8000000
    ],
    "migration_cost_ns": [
      0,
      2000000
    ],
    "min_perf_pct": [
      45,
      100
    ],
    "max_perf_pct": [
      80,
      100
    ]
  },
  "actor_model": "gemini-3.5-flash",
  "instant_model": "gemini-3.5-flash-lite",
  "llm_timeout_seconds": 90,
  "applications": [
    {
      "id": "cpu_latency",
      "metric": "latency_p99_ms",
      "objective": "minimize",
      "bound": "default",
      "priority": 1,
      "ready_signal": true,
      "start": [
        "/work_dir/tuxbot-venv/bin/python",
        "-m",
        "extension.sysbench",
        "serve",
        "results/relationships-01/configs/cpu-memory-contention-A-cpu_latency.json"
      ],
      "measure": [
        "/work_dir/tuxbot-venv/bin/python",
        "-m",
        "extension.sysbench",
        "measure",
        "results/relationships-01/configs/cpu-memory-contention-A-cpu_latency.json"
      ]
    },
    {
      "id": "memory_bandwidth",
      "metric": "throughput_mib_s",
      "objective": "maximize",
      "bound": "default",
      "priority": 1,
      "ready_signal": true,
      "start": [
        "/work_dir/tuxbot-venv/bin/python",
        "-m",
        "extension.sysbench",
        "serve",
        "results/relationships-01/configs/cpu-memory-contention-A-memory_bandwidth.json"
      ],
      "measure": [
        "/work_dir/tuxbot-venv/bin/python",
        "-m",
        "extension.sysbench",
        "measure",
        "results/relationships-01/configs/cpu-memory-contention-A-memory_bandwidth.json"
      ]
    }
  ],
  "workload_conditions": {
    "cpu_latency": {
      "program": "sysbench",
      "version": "sysbench 1.0.20",
      "workload": "cpu",
      "threads": 8,
      "rand_seed": 1,
      "report_interval_seconds": 1,
      "cpu_affinity": null,
      "cpu_max_prime": 20000
    },
    "memory_bandwidth": {
      "program": "sysbench",
      "version": "sysbench 1.0.20",
      "workload": "memory",
      "threads": 8,
      "rand_seed": 1,
      "report_interval_seconds": 1,
      "cpu_affinity": null,
      "memory_block_size": "256M",
      "memory_scope": "local",
      "memory_oper": "read",
      "memory_access_mode": "seq"
    }
  }
}
