  "approved_host_parameters": ["min_granularity_ns", "latency_ns", "wakeup_granularity_ns", "migration_cost_ns", "napi_busy_poll", "min_perf_pct", "max_perf_pct"],
  "actor_model": "gemini-2.5-flash",
