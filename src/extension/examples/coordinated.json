    {"id": "application_B", "metric": "throughput", "objective": "maximize", "bound": "default", "priority": 1, "ready_signal": true, "start": ["python3", "-m", "extension.tailbench", "serve", "src/extension/examples/img-dnn.json"], "measure": ["python3", "-m", "extension.tailbench", "measure", "src/extension/examples/img-dnn.json"]}
